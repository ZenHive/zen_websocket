# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
websockex_nova-*.tar
zen_websocket-*.tar

# Temporary files, for example, from tests.
/tmp/
.elixir_ls/
# .cursor/*

# Harness writes these into the run worktree at dispatch time (per-run agent
# rules + Cursor's native rule file). Ephemeral — never commit them.
/.harness/
/.cursor/rules/

# Personal, machine-local Claude Code overrides. `.claude/settings.json`
# (project scope: marketplaces + enabled plugins) IS committed.
/.claude/settings.local.json
/.claude/audit/
/.claude/plans/
/.claude/research/
/.claude/reviews/
/.claude/skill-metrics/
/.claude/solutions/

# Dialyzer PLT files
/priv/plts/*.plt
/priv/plts/*.plt.hash

# Machine-local hex-docs fetch cache
/.hex-docs/
